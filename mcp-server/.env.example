# ─────────────────────────────────────────────
# AEGIS MCP Server — Environment Variables
# ─────────────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development

# FastAPI backend (AI engine)
FASTAPI_URL=http://localhost:8000

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ─────────────────────────────────────────────
# Storage: "local" or "gdrive"
# ─────────────────────────────────────────────
STORAGE_BACKEND=local

# Option A — Local JSON storage
EVIDENCE_DIR=./evidence

# Option B — Google Drive (only needed if STORAGE_BACKEND=gdrive)
GDRIVE_FOLDER_ID=your-google-drive-folder-id
GDRIVE_SERVICE_ACCOUNT_KEY_PATH=./config/gdrive-service-account.json
