# AEGIS Backend Environment Variables

# API Configuration
ENVIRONMENT=development
PORT=8000

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# OpenAI Configuration (Optional - uses rules-based if not set)
OPENAI_API_KEY=sk-your-key-here

# Slack Configuration (Optional - alerts disabled if not set)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Database Configuration
DATABASE_URL=sqlite:///./data/aegis.db

# Logging
LOG_LEVEL=INFO

MCP_SERVER_URL=http://localhost:3001/process

# Auth (REQUIRED in production)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ISSUER=aegis
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
